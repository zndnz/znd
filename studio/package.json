{
  "name": "znd-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "znd の新しい画面。操作と表示は TypeScript、実行は Rust（crates/znd-studio）。",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "tauri": "tauri --config ../crates/znd-studio/tauri.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
