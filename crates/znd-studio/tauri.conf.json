{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "znd studio",
  "version": "0.1.0",
  "identifier": "app.znd.studio",
  "build": {
    "frontendDist": "../../studio/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix ../studio run dev",
    "beforeBuildCommand": "npm --prefix ../studio run build"
  },
  "app": {
    "windows": [
      {
        "title": "znd",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
